NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Must match the QNH Portal JWT signing secret.
PORTAL_JWT_SECRET=replace-with-portal-jwt-secret

DB_SERVER=localhost
DB_DATABASE=QNH_TaskManagement
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

APP_TIME_ZONE=Asia/Riyadh
ATTACHMENT_STORAGE_PATH=storage/attachments

# Procurement source synchronization is owned by the backend worker.
PROCUREMENT_SYNC_ENABLED=false
PROCUREMENT_SYNC_INTERVAL_MINUTES=15
PROCUREMENT_SYNC_RUN_ON_START=true
PROCUREMENT_SYNC_REQUEST_TIMEOUT_MS=600000


# Manual Meeting PDF export (Phase 3). No external PDF service is used.
# Default: run `pnpm run pdf:install-browser` once as the backend's operating-system user.
# For a shared browser cache, set PLAYWRIGHT_BROWSERS_PATH before BOTH install and runtime.
# PLAYWRIGHT_BROWSERS_PATH=D:/TaskHubRuntime/pdf-browsers
# Or use an already installed Microsoft Edge instead of downloading Chromium:
# MEETING_REPORT_BROWSER_CHANNEL=msedge
# An explicit executable path takes precedence over the channel:
# MEETING_REPORT_BROWSER_EXECUTABLE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Logo is loaded locally from client/public/images/fullLogo.png (or client/dist/images/fullLogo.png).
# Optional local PNG path, absolute or relative to the server folder; remote URLs are not supported.
# MEETING_REPORT_LOGO_PATH=D:/TaskHubRuntime/fullLogo.png
MEETING_REPORT_TIMEOUT_MS=45000
MEETING_REPORT_MAX_CONCURRENT=2

# Automatic Meeting PDF emails (Phase 5): migration 044 + existing EMAIL_ENABLED=true required.
# Kill switch affects report mail only; manual PDF export and other emails remain available.
MEETING_REPORT_EMAIL_ENABLED=true
MEETING_REPORT_EMAIL_MAX_PDF_BYTES=10485760
# Activation cutoff is stored once by migration 044, not recomputed on worker restart.

